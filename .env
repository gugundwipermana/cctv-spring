# Lokasi folder penyimpanan frame + video di HOST (di luar container).
#
# Sekarang (testing di PC): folder lokal relatif, otomatis dibuat Docker.
# STORAGE_HOST_PATH=./storage
#
# Nanti kalau sudah pindah ke server, ganti baris di atas jadi:
STORAGE_HOST_PATH=/mnt/storage/cctv
#
# Itu saja yang perlu diubah - tidak perlu edit docker-compose.yml.
CCTV_ADMIN_USERNAME=admin
CCTV_ADMIN_PASSWORD=GantiDenganPasswordKuatAnda123!
CCTV_API_KEY=generate-random-string-panjang-untuk-esp32-dan-curl